#
# Generates Allowlist.nsh for DisplayXROpenTrackingInstaller.nsi: the ADR-054 N4b
# provenance allowlist row for the provider DLL this installer ships.
#
# Adapted from displayxr-runtime/installer/gen_allowlist_nsh.cmake; the row format
# (value name = SHA-256 hex digest under HKLM\Software\DisplayXR\Trust\Allowlist)
# is the runtime's, unchanged.
#
# The provenance gate ENFORCES by default on Windows: a component binary must be
# Authenticode-signed or have its SHA-256 under HKLM\Software\DisplayXR\Trust\Allowlist,
# or the loader refuses it as `unverified`. A signed release passes on the signature
# alone; an unsigned build (CI, a release the signing provider missed) would otherwise
# install a provider the runtime refuses. So the installer writes the digest of exactly
# the bytes it ships, computed here at packaging time (after signing, when signed), and
# the uninstaller removes the same row. One DLL, one row: the runtime loads the same
# binary for both roles (TrackingProviders\open-tracking and
# InputProviders\open-tracking-hands). ONNX Runtime is loaded by the provider itself,
# not by the runtime's component loader, so it is not gated.
#
# Invoked by the release workflow before makensis:
#   cmake -DBIN_DIR=<dist> -DVERSION=<x.y.z> -DOUT=<Allowlist.nsh> -P installer/gen_allowlist_nsh.cmake

if(NOT DEFINED BIN_DIR OR NOT DEFINED OUT)
	message(FATAL_ERROR "gen_allowlist_nsh.cmake: BIN_DIR and OUT are required")
endif()
if(NOT DEFINED VERSION)
	set(VERSION "dev")
endif()

set(_dll "${BIN_DIR}/DisplayXR-OpenTracking.dll")
if(NOT EXISTS "${_dll}")
	message(FATAL_ERROR "gen_allowlist_nsh.cmake: shipped provider missing: ${_dll}")
endif()
file(SHA256 "${_dll}" _hex)
message(STATUS "allowlist: DisplayXR-OpenTracking.dll sha256=${_hex}")

file(WRITE "${OUT}"
	"; Auto-generated by installer/gen_allowlist_nsh.cmake — do not edit.\n"
	"; ADR-054 N4b provenance allowlist row for the provider DLL this installer ships.\n"
	"!define OT_ALLOWLIST_SHA256 \"${_hex}\"\n"
	"!macro DXR_ALLOWLIST_WRITE\n"
	"\tWriteRegStr HKLM \"Software\\DisplayXR\\Trust\\Allowlist\" \"${_hex}\" \"DisplayXR-OpenTracking.dll (DisplayXR Open Tracking installer ${VERSION})\"\n"
	"!macroend\n"
	"!macro DXR_ALLOWLIST_REMOVE\n"
	"\tDeleteRegValue HKLM \"Software\\DisplayXR\\Trust\\Allowlist\" \"${_hex}\"\n"
	"\tDeleteRegKey /ifempty HKLM \"Software\\DisplayXR\\Trust\\Allowlist\"\n"
	"\tDeleteRegKey /ifempty HKLM \"Software\\DisplayXR\\Trust\"\n"
	"!macroend\n")
